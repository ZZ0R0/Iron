import account

# transaction kind codes: 4=transfer_in 5=transfer_out

class Bank:
    name: str
    accounts: list[Account]
    next_id: i64
    log: list[i64]

    def open_account(self, owner: str, opening: i64) -> i64:
        aid = self.next_id
        acc = Account(id=aid, owner=owner, balance=0, kinds=[], amounts=[])
        if opening > 0:
            acc.deposit(opening)
        self.accounts.append(acc)
        self.next_id = self.next_id + 1
        return aid

    def deposit(self, aid: i64, amount: i64) -> i64:
        ok = self.accounts[aid].deposit(amount)
        self.log.append(ok)
        return ok

    def withdraw(self, aid: i64, amount: i64) -> i64:
        ok = self.accounts[aid].withdraw(amount)
        self.log.append(ok)
        return ok

    def transfer(self, src: i64, dst: i64, amount: i64) -> i64:
        if amount <= 0:
            self.log.append(0)
            return 0
        ok = self.accounts[src].debit(amount, 5)
        if ok == 0:
            self.log.append(0)
            return 0
        self.accounts[dst].credit(amount, 4)
        self.log.append(1)
        return 1

    def apply_interest_all(self, rate_bps: i64) -> i64:
        total = 0
        for i in range(len(self.accounts)):
            total = total + self.accounts[i].apply_interest(rate_bps)
        self.log.append(total)
        return total

    def balance_of(self, aid: i64) -> i64:
        return self.accounts[aid].balance

    def total_assets(self) -> i64:
        total = 0
        for i in range(len(self.accounts)):
            total = total + self.accounts[i].balance
        return total

    def count(self) -> i64:
        return len(self.accounts)

    def ops_logged(self) -> i64:
        return len(self.log)

    def successful_ops(self) -> i64:
        c = 0
        for i in range(len(self.log)):
            if self.log[i] > 0:
                c = c + 1
        return c

    def richest(self) -> i64:
        best = 0
        best_bal = -1
        for i in range(len(self.accounts)):
            bal = self.accounts[i].balance
            if bal > best_bal:
                best_bal = bal
                best = self.accounts[i].id
        return best
