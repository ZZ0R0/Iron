class Team:
    tid: i64
    name: str
    strength: i64
    seed: i64
    wins: i64

def strength_of(teams: list[Team], tid: i64) -> i64:
    for t in teams:
        if t.tid == tid:
            return t.strength
    return 0

def name_of(teams: list[Team], tid: i64) -> str:
    for t in teams:
        if t.tid == tid:
            return t.name
    return "?"

def seed_ids(teams: list[Team], ids: list[i64]) -> list[i64]:
    result = []
    for x in ids:
        result.append(x)
    n = len(result)
    for i in range(n):
        best = i
        for j in range(i + 1, n):
            sj = strength_of(teams, result[j])
            sb = strength_of(teams, result[best])
            if sj > sb:
                best = j
            elif sj == sb:
                if result[j] < result[best]:
                    best = j
        tmp = result[i]
        result[i] = result[best]
        result[best] = tmp
    return result

def names_of(teams: list[Team], ids: list[i64]) -> str:
    parts = []
    for x in ids:
        parts.append(name_of(teams, x))
    return join(parts, ",")
