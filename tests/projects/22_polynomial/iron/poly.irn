# Polynomials with integer coefficients.
# Representation: coeffs[i] is the coefficient of x**i (ascending power order).

class Poly:
    coeffs: list[i64]

    def degree(self) -> i64:
        d = len(self.coeffs) - 1
        while d > 0 and self.coeffs[d] == 0:
            d = d - 1
        return d

    def is_zero(self) -> bool:
        for c in self.coeffs:
            if c != 0:
                return False
        return True

    def evaluate(self, x: i64) -> i64:
        # Horner's method, walking from the highest power down.
        d = self.degree()
        acc = 0
        i = d
        while i >= 0:
            acc = acc * x + self.coeffs[i]
            i = i - 1
        return acc

    def add(self, other: Poly) -> Poly:
        n = len(self.coeffs)
        m = len(other.coeffs)
        size = n
        if m > size:
            size = m
        out = []
        i = 0
        while i < size:
            a = 0
            if i < n:
                a = self.coeffs[i]
            b = 0
            if i < m:
                b = other.coeffs[i]
            out.append(a + b)
            i = i + 1
        return make(out)

    def sub(self, other: Poly) -> Poly:
        n = len(self.coeffs)
        m = len(other.coeffs)
        size = n
        if m > size:
            size = m
        out = []
        i = 0
        while i < size:
            a = 0
            if i < n:
                a = self.coeffs[i]
            b = 0
            if i < m:
                b = other.coeffs[i]
            out.append(a - b)
            i = i + 1
        return make(out)

    def scale(self, k: i64) -> Poly:
        out = []
        for c in self.coeffs:
            out.append(c * k)
        return make(out)

    def mul(self, other: Poly) -> Poly:
        n = len(self.coeffs)
        m = len(other.coeffs)
        out = []
        i = 0
        while i < n + m - 1:
            out.append(0)
            i = i + 1
        i = 0
        while i < n:
            j = 0
            while j < m:
                out[i + j] = out[i + j] + self.coeffs[i] * other.coeffs[j]
                j = j + 1
            i = i + 1
        return make(out)

    def derivative(self) -> Poly:
        out = []
        i = 1
        while i < len(self.coeffs):
            out.append(self.coeffs[i] * i)
            i = i + 1
        if len(out) == 0:
            out.append(0)
        return make(out)

    def power(self, e: i64) -> Poly:
        bcoeffs = []
        for c in self.coeffs:
            bcoeffs.append(c)
        base = make(bcoeffs)
        result = make([1])
        i = 0
        while i < e:
            result = result.mul(base)
            i = i + 1
        return result

    def coeff_list(self) -> list[i64]:
        d = self.degree()
        out = []
        i = 0
        while i <= d:
            out.append(self.coeffs[i])
            i = i + 1
        return out


def make(coeffs: list[i64]) -> Poly:
    p = Poly(coeffs=coeffs)
    return p


def term_str(coef: i64, power: i64) -> str:
    if power == 0:
        return str(coef)
    if power == 1:
        return f"{coef}x"
    return f"{coef}x^{power}"


def poly_str(p: Poly) -> str:
    d = p.degree()
    parts = []
    i = d
    while i >= 0:
        c = p.coeffs[i]
        if c != 0:
            parts.append(term_str(c, i))
        i = i - 1
    if len(parts) == 0:
        return "0"
    return join(parts, " + ")
