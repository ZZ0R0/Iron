# cell codes: 0=empty 1=X 2=O
# winner codes: 0=none/ongoing 1=X 2=O 3=draw

class Board:
    cells: list[i64]

    def place(self, idx: i64, player: i64) -> i64:
        if self.cells[idx] != 0:
            return 0
        self.cells[idx] = player
        return 1

    def clear(self, idx: i64):
        self.cells[idx] = 0

    def with_move(self, idx: i64, player: i64) -> Board:
        next_cells = []
        for v in self.cells:
            next_cells.append(v)
        next_cells[idx] = player
        return Board(cells=next_cells)

    def count_filled(self) -> i64:
        c = 0
        for v in self.cells:
            if v != 0:
                c = c + 1
        return c

    def is_full(self) -> i64:
        if self.count_filled() == 9:
            return 1
        return 0

    def line_winner(self) -> i64:
        lines = []
        lines.append((0, 1, 2))
        lines.append((3, 4, 5))
        lines.append((6, 7, 8))
        lines.append((0, 3, 6))
        lines.append((1, 4, 7))
        lines.append((2, 5, 8))
        lines.append((0, 4, 8))
        lines.append((2, 4, 6))
        for line in lines:
            a = self.cells[line.0]
            b = self.cells[line.1]
            c = self.cells[line.2]
            if a != 0 and a == b and b == c:
                return a
        return 0

    def winner(self) -> i64:
        w = self.line_winner()
        if w != 0:
            return w
        if self.is_full() == 1:
            return 3
        return 0

    def available(self) -> list[i64]:
        out = []
        i = 0
        while i < 9:
            if self.cells[i] == 0:
                out.append(i)
            i = i + 1
        return out

    def render(self) -> str:
        rows = []
        r = 0
        while r < 3:
            chars = []
            k = 0
            while k < 3:
                v = self.cells[r * 3 + k]
                if v == 1:
                    chars.append("X")
                elif v == 2:
                    chars.append("O")
                else:
                    chars.append(".")
                k = k + 1
            rows.append(join(chars, ""))
            r = r + 1
        return join(rows, "|")


def make_board() -> Board:
    cells = []
    i = 0
    while i < 9:
        cells.append(0)
        i = i + 1
    return Board(cells=cells)
