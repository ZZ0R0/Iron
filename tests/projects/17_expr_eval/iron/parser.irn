# Shunting-yard: convert an infix token list into a postfix (RPN) token list.
#
# All four binary operators (+ - * /) are left-associative, so an operator on
# top of the stack with precedence >= the incoming operator is popped to the
# output before the incoming one is pushed. Parentheses group sub-expressions
# and never reach the output.
#
# The operator stack is a plain list of operator codes (ints); a '(' is code 4
# and a ')' is code 5. The output is a (kind, value) token list, exactly the
# same encoding tokenize() produces, minus the parentheses.

import tokens

def to_rpn(toks: list[(i64, i64)]) -> list[(i64, i64)]:
    output = []
    ops = []
    for t in toks:
        kind = t.0
        val = t.1
        if kind == 0:
            output.append((0, val))
        elif val == 4:
            ops.append(4)
        elif val == 5:
            while len(ops) > 0 and ops[len(ops) - 1] != 4:
                top = ops[len(ops) - 1]
                ops.pop()
                output.append((1, top))
            if len(ops) > 0:
                ops.pop()
        else:
            while len(ops) > 0 and ops[len(ops) - 1] != 4 and precedence(ops[len(ops) - 1]) >= precedence(val):
                top = ops[len(ops) - 1]
                ops.pop()
                output.append((1, top))
            ops.append(val)
    while len(ops) > 0:
        top = ops[len(ops) - 1]
        ops.pop()
        output.append((1, top))
    return output

def max_stack_depth(toks: list[(i64, i64)]) -> i64:
    rpn = to_rpn(toks)
    depth = 0
    best = 0
    for t in rpn:
        if t.0 == 0:
            depth = depth + 1
        else:
            depth = depth - 1
        if depth > best:
            best = depth
    return best
