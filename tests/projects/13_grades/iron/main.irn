import student
import gradebook

def build_roster() -> list[Student]:
    roster = []
    roster.append(Student(name="alice", courses=["math", "cs", "art"], grades=[92, 88, 95]))
    roster.append(Student(name="bob", courses=["math", "cs", "art"], grades=[60, 72, 55]))
    roster.append(Student(name="carol", courses=["math", "cs", "art"], grades=[80, 80, 80]))
    roster.append(Student(name="dave", courses=["math", "cs", "art"], grades=[45, 50, 65]))
    roster.append(Student(name="erin", courses=["math", "cs", "art"], grades=[99, 91, 90]))
    roster.append(Student(name="frank", courses=["math", "cs", "art"], grades=[70, 68, 74]))
    return roster

def main():
    roster = build_roster()

    print("=== averages ===")
    for s in roster:
        print(f"{s.name} avg={s.average()} best={s.best()} worst={s.worst()} passed={s.passed(70)}")

    print("=== ranking ===")
    rank = 1
    for p in ranking(roster):
        avg = -p.0
        name = p.1
        print(f"{rank} {name} {avg} {mention(avg)}")
        rank = rank + 1

    print("=== distribution ===")
    dist = distribution(roster)
    for m in sorted(dist.keys()):
        print(f"{m}={dist[m]}")

    print("=== courses ===")
    sums = course_sums(roster)
    cnts = course_counts(roster)
    for c in sorted(sums.keys()):
        avg = sums[c] // cnts[c]
        high = course_high(roster, c)
        print(f"{c} avg={avg} high={high} students={cnts[c]}")

    print("=== summary ===")
    print(f"students={len(roster)}")
    print(f"class_average={class_average(roster)}")
    print(f"honor_roll={honor_count(roster)}")
    ranked = ranking(roster)
    top = ranked[0]
    print(f"top_student={top.1}")
