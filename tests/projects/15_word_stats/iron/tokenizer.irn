def normalize(text: str) -> str:
    puncts = [".", ",", ";", ":", "!", "?", "(", ")", "[", "]",
              "\"", "'", "-", "_", "/", "\n", "\t", "*"]
    out = text.lower()
    for p in puncts:
        out = out.replace(p, " ")
    return out


def tokenize(text: str) -> list[str]:
    cleaned = normalize(text)
    raw = cleaned.split(" ")
    words = []
    for w in raw:
        if len(w) > 0:
            words.append(w)
    return words


def count_char(text: str, ch: str) -> i64:
    parts = text.split(ch)
    n = len(parts) - 1
    return n


def sentence_count(text: str) -> i64:
    count = 0
    for ch in [".", "!", "?"]:
        count = count + count_char(text, ch)
    return count


def total_chars(words: list[str]) -> i64:
    total = 0
    for w in words:
        total = total + len(w)
    return total


def longest(words: list[str]) -> str:
    best = ""
    best_len = -1
    for w in words:
        if len(w) > best_len:
            best_len = len(w)
            best = w
    return best


def shortest(words: list[str]) -> str:
    best = ""
    best_len = 1000000
    for w in words:
        if len(w) < best_len:
            best_len = len(w)
            best = w
    return best
