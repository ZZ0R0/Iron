# break + continue.
def main():
    total = 0
    for i in range(1, 11):
        if i % 2 == 1:
            continue
        if i > 8:
            break
        total = total + i
    print(total)
    found = 0
    for k in range(1, 100):
        if k % 7 == 0:
            found = k
            break
    print(found)
