# if / elif / else + opérateur ternaire.
def classify(n):
    if n > 0:
        return "positif"
    elif n == 0:
        return "zero"
    else:
        return "negatif"

def main():
    print(classify(7))
    print(classify(0))
    print(classify(-4))
    n = 6
    parity = "pair" if n % 2 == 0 else "impair"
    print(parity)
