# Listes imbriquées : indexation 2D, ligne entière, double boucle d'accumulation.
fn main():
    grid = [[1, 2, 3], [4, 5, 6], [7, 8, 9]]
    print(grid[1][2])
    print(len(grid))
    print(grid[0])
    total = 0
    for row in grid:
        for v in row:
            total = total + v
    print(total)
    print(grid)
