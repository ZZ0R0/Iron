# Itération + accumulation : somme, produit, puis max/min/sum builtins.
fn main():
    xs = [3, 1, 4, 1, 5, 9, 2, 6]
    total = 0
    prod = 1
    for x in xs:
        total = total + x
        prod = prod * x
    print(total)
    print(prod)
    print(max(xs))
    print(min(xs))
    print(sum(xs))
