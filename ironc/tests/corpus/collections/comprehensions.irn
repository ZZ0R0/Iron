# Compréhensions liste / dict / set ; sorties déterministes (liste, agrégats, len).
fn main():
    squares = [x * x for x in range(1, 6)]
    print(squares)
    evens = [x for x in range(10) if x % 2 == 0]
    print(evens)
    d = {x: x * x for x in range(1, 5)}
    print(sum(d.values()))
    print(len(d))
    s = {x % 3 for x in range(10)}
    print(len(s))
