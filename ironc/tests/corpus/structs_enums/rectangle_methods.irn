class Rectangle:
    width: i64
    height: i64
    def area(self) -> i64:
        return self.width * self.height
    def perimeter(self) -> i64:
        return 2 * (self.width + self.height)
    def is_square(self) -> bool:
        return self.width == self.height

def main():
    r = Rectangle(width=4, height=6)
    print(r.area())
    print(r.perimeter())
    print(r.is_square())
    s = Rectangle(width=5, height=5)
    print(s.is_square())
