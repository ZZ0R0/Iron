use "csv.iri"

def count_rows(data: str) -> i64:
    n = 0
    rust {
        let mut rdr = csv::ReaderBuilder::new().has_headers(false).from_reader(data.as_bytes());
        n = rdr.records().filter(|r| r.is_ok()).count() as i64;
    }
    return n

def main():
    print(count_rows("1,2,3\n4,5,6\n7,8,9"))
    print(count_rows("a,b\nc,d"))
