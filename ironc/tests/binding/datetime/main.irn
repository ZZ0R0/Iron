use "chrono.iri"

def year_of(date: str) -> Result[i64]:
    d = NaiveDate.parse_from_str(date, "%Y-%m-%d")?
    return to_i64(d.year())

def day_of_year(date: str) -> Result[i64]:
    d = NaiveDate.parse_from_str(date, "%Y-%m-%d")?
    return to_i64(d.ordinal())

def main():
    print(year_of("2026-06-26").unwrap_or(0))
    print(day_of_year("2026-06-26").unwrap_or(0))
