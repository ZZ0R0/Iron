import std

def main():
    n = int(args()[1])
    best = 0
    start = 1
    while start < n:
        x = start
        steps = 0
        while x != 1:
            if x % 2 == 0:
                x = x // 2
            else:
                x = 3 * x + 1
            steps += 1
        if steps > best:
            best = steps
        start += 1
    print(best)
