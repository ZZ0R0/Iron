# [V7/2.6] Type set : littéral, membership, add, union/inter/diff.

fn main():
    s = {1, 2, 2, 3}
    print(len(s))
    print(2 in s)
    print(5 in s)
    add(s, 5)
    print(5 in s)
    a = {1, 2, 3}
    b = {2, 3, 4}
    print(len(union(a, b)))
    print(len(inter(a, b)))
    print(len(diff(a, b)))
