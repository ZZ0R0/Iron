# [V7/2.7] Compréhensions liste / dict / set.

fn main():
    squares = [x * x for x in [1, 2, 3, 4]]
    print(squares)
    evens = [x for x in range(10) if x % 2 == 0]
    print(evens)
    d = {x: x * x for x in [1, 2, 3]}
    print(len(d))
    s = {x % 3 for x in [1, 2, 3, 4, 5, 6]}
    print(len(s))
