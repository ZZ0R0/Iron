# [V6/4.4] Comparaison chaînée : `a < b < c` ≡ `a < b and b < c`.

fn classify(x: i64) -> str:
    if 0 < x < 10:
        return "petit"
    if 10 <= x <= 100:
        return "moyen"
    return "grand"

fn main():
    print(classify(5))
    print(classify(50))
    print(classify(500))
    a = 1
    b = 2
    c = 3
    d = 4
    if a < b < c < d:
        print("strictement croissant")
