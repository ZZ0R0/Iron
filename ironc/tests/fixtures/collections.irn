fn sum_to(n: i64) -> i64:
    total = 0
    for i in range(1, n):
        total = total + i
    return total

fn main():
    xs = [10, 20, 30]
    acc = 0
    for x in xs:
        acc = acc + x
    print(acc)
    print(len(xs))
    print(xs[1])
    print(sum_to(5))
    ages = {1: 100, 2: 200}
    print(ages[2])
