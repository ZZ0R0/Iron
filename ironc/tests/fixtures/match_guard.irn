# [V6/3.2] Motifs match avancés : gardes (`if`) + motifs imbriqués.

enum Tree:
    Leaf(i64)
    Pair(i64, i64)

fn sign(o: Option[i64]) -> str:
    match o:
        Some(x) if x > 0:
            return "positif"
        Some(x) if x < 0:
            return "negatif"
        Some(x):
            return "zero"
        None:
            return "absent"

fn top(o: Option[Tree]) -> i64:
    match o:
        Some(Tree.Leaf(n)):
            return n
        Some(Tree.Pair(a, b)):
            return a + b
        None:
            return -1

fn main():
    print(sign(some(7)))
    print(sign(some(-2)))
    print(sign(some(0)))
    print(sign(none))
    print(top(some(Tree.Leaf(42))))
    print(top(some(Tree.Pair(10, 20))))
    print(top(none))
